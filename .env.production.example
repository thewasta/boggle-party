# Production Environment Variables for Coolify
# Add these in Coolify's environment variables section

# Web Service
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Database Connection (use Coolify's managed PostgreSQL)
DATABASE_URL=postgresql://boggle_user:changeme_secure_random_password_here@db:5432/boggle_party


# Database Service (separate resource in Coolify)
POSTGRES_DB=boggle_party
POSTGRES_USER=boggle_user
POSTGRES_PASSWORD=changeme_secure_random_password_here

# WebSocket Configuration (self-hosted)
WS_HTTP_URL=http://websocket:3001
NEXT_PUBLIC_WS_URL=wss://your-domain.com
CORS_ORIGIN=https://your-domain.com
